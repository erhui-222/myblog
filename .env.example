# 数据库：运行时用池化串，迁移用直连串
# Vercel Marketplace 的 Neon 集成会自动注入以下两个变量
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

SITE_URL="https://your-domain.vercel.app"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-please"
IP_SALT="dev-only-salt-change-in-production"

# 必须低于 Vercel 函数 4.5MB 的请求体上限
UPLOAD_MAX_MB="4"

# 保护 /api/cron/*，Vercel Cron 触发时带 Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me-please"

# 图片存储（Vercel Blob）：部署时由 OIDC 自动提供，本地开发用 npx vercel env pull 拉取
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

TZ="Asia/Shanghai"
