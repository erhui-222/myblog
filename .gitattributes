# 统一换行符：仓库内一律 LF，避免 Windows 上编辑后把 CRLF 带进 Docker 镜像
* text=auto eol=lf

# 需要在 Linux 容器内直接执行的脚本，必须 LF
*.sh text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
